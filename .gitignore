# ============================================================
# CODESEVEN.RU — ФАЙЛЫ, КОТОРЫЕ НЕ ДОЛЖНЫ ПОПАДАТЬ В GIT
# ============================================================

# ------------------------------------------------------------
# Переменные окружения
#
# Файл .env содержит реальные пароли, API-ключи и другие
# секретные данные конкретного окружения.
# Его никогда нельзя добавлять в репозиторий.
#
# .env.example, наоборот, будет храниться в Git как пример
# необходимых настроек без настоящих паролей.
# ------------------------------------------------------------

.env
.env.*
!.env.example


# ------------------------------------------------------------
# Локальные настройки редакторов и IDE
# ------------------------------------------------------------

.vscode/
.idea/
.codegpt/


# ------------------------------------------------------------
# Системные файлы Windows/macOS
# ------------------------------------------------------------

Thumbs.db
desktop.ini
.DS_Store


# ------------------------------------------------------------
# Логи и временные файлы
# ------------------------------------------------------------

*.log
*.tmp
*.temp
*.bak
*.swp


# ------------------------------------------------------------
# Резервные копии проекта
#
# Папка backup уже присутствует в старой версии репозитория.
# В дальнейшем резервные копии исходников не должны храниться
# внутри Git — для этого существует сама история Git.
# ------------------------------------------------------------

backup/


# ------------------------------------------------------------
# Composer
#
# vendor/ генерируется командой composer install.
# Сам каталог библиотек хранить в Git не требуется.
# composer.json и composer.lock, наоборот, должны храниться.
# ------------------------------------------------------------

vendor/
