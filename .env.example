# ============================================================
# CODESEVEN.RU — ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
#
# Скопируйте этот файл в .env и заполните реальные значения.
#
# ВАЖНО:
# .env.example разрешено хранить в Git.
# .env с настоящими паролями хранить в Git запрещено.
# ============================================================


# ------------------------------------------------------------
# Основные настройки приложения
# ------------------------------------------------------------

APP_ENV=local
APP_DEBUG=false


# ------------------------------------------------------------
# SMTP — отправка почты
# ------------------------------------------------------------

SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl


# ------------------------------------------------------------
# Платёжная система
# ------------------------------------------------------------

PAYMENT_TERMINAL_KEY=
PAYMENT_PASSWORD=

# ------------------------------------------------------------
# Платёжная система
#
# Платёжный функционал временно отключён.
# Пока значение false, api/payment.php не должен выполнять
# никаких запросов к платёжному шлюзу.
# ------------------------------------------------------------

PAYMENT_ENABLED=false
